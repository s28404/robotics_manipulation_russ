<?xml version="1.0"?>
<sdf version="1.7" xmlns:drake="http://drake.mit.edu">
  <model name="hydro_table">
    <link name="link">
      <visual name="visual">
        <geometry><box><size>1.5 1.5 0.1</size></box></geometry>
        <pose>0 0 -0.05 0 0 0</pose>
        <material><diffuse>0.5 0.5 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>1.5 1.5 0.1</size></box></geometry>
        <pose>0 0 -0.05 0 0 0</pose>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>5.0e6</drake:hydroelastic_modulus>
          <drake:hunt_crossley_dissipation>5.0</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>
