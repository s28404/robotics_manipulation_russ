        <mass>0.01</mass>
        <pose>0.08886 0.08082 0.04000 0 0 0</pose>
        <inertia>
          <ixx>2.15219e-05</ixx>
          <ixy>9.88056e-09</ixy>
          <ixz>-1.07242e-20</ixz>
          <iyy>2.92640e-05</iyy>
          <iyz>-1.07242e-20</iyz>
          <izz>4.01193e-05</izz>
        </inertia>
